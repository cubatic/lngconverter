# YouTube ingestion must only be enabled when the operator has the required
# content rights and platform authorization.
LGN_ENABLE_YOUTUBE_SOURCE=false
LGN_ARTIFACT_DIR=artifacts
LGN_WHISPER_MODEL=small
LGN_WHISPER_DEVICE=auto
LGN_WHISPER_COMPUTE_TYPE=auto
LGN_MAX_SOURCE_SECONDS=180
LGN_KEEP_AUDIO_ARTIFACTS=true

