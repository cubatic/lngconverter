[Unit]
Description=LGN Converter API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lgnconverter
Group=www-data
WorkingDirectory=/opt/lngconverter
EnvironmentFile=/etc/lgnconverter.env
ExecStart=/opt/lngconverter/.venv/bin/uvicorn lgnconverter.api:app --host 127.0.0.1 --port 4600 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/lgnconverter

[Install]
WantedBy=multi-user.target
